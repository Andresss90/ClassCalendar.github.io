rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isTeacherOrRepresentative() {
      return request.auth != null && myRole() in ['teacher', 'representative'];
    }
    function isRepresentative() {
      return request.auth != null && myRole() == 'representative';
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /schoolTasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if isTeacherOrRepresentative();
    }

    // Regla para Eventos Escolares
    match /schoolEvents/{eventId} {
      allow read: if request.auth != null;
      allow write: if isTeacherOrRepresentative();
    }

    // Los representantes editan el horario del curso. Los profesores solo pueden
    // escribir su propio horario personal "My Flow" (documento myflow_{su uid}).
    match /schedules/{courseId} {
      allow read: if request.auth != null;
      allow write: if isRepresentative()
        || (request.auth != null && myRole() == 'teacher' && courseId == 'myflow_' + request.auth.uid);
    }

    // Regla para overrides de eventos generales (Semana Santa, Día de la Familia, etc.) por curso
    match /generalEventOverrides/{overrideId} {
      allow read: if request.auth != null;
      allow write: if isTeacherOrRepresentative();
    }

    match /users/{userId}/personalTodos/{todoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/completedSchoolTasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
